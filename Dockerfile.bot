FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-rus tzdata && rm -r /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY run_bot.py ./
COPY bot ./bot
ENV PYTHONDONTWRITEBYTECODE=1
USER 65534:65534
CMD ["python", "run_bot.py"]
